# Supabase public client configuration. Never put a secret or service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Enable only after configuring the Google provider in Supabase.
VITE_GOOGLE_AUTH_ENABLED=false

# The learning assistant runs locally in the browser and needs no AI key.
# Never put an AI provider key in a VITE_ variable: those are bundled into the public site.
